# Arc Smart Orders — persistent keeper (env for /opt/arc-smart-orders/keeper)
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Keeper hot wallet (pays gas in USDC; keep it low-privilege, funded with a little USDC)
KEEPER_PK=0xYOUR_KEEPER_PRIVATE_KEY

# Deployed contracts
EXECUTOR=0x5E9dCd592B37fda481Fc203756DA4D990cE438bA
ROUTER=0xcDeA0D5BcD78dB86D7A5f4E976976400a5b4dffc

# Worker
MIN_FEE_GWEI=20
LOOP_MS=8000
DRY=0

# API
PORT=8788
DB_PATH=data/orders.db
