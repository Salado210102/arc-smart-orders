# Arc Smart Orders — persistent keeper (copy to keeper/.env, chmod 600). VPS path: /var/www/arc-keeper/keeper
ARC_RPC=https://rpc.mainnet.arc.io
CHAIN_ID=5042

# Keeper hot wallet (pays gas in USDC; keep it low-privilege, funded with a little USDC)
KEEPER_PK=0xYOUR_KEEPER_PRIVATE_KEY

# Deployed contracts (Arc MAINNET)
EXECUTOR=0x9b3a990d1a31Ff5E01ddB8702e10F2529811FDb7
ROUTER=0x0000000000000000000000000000000000000000   # swap venue — see SWAP_VENUE below

# Venue: "mock" (testnet MockStableRouter) or "uniswap-v3" (Arc mainnet, live USDC/EURC pool)
SWAP_VENUE=mock
# Uniswap v3 (mainnet): USDC/EURC pool fee tier + factory address (used when SWAP_VENUE=uniswap-v3)
UNIV3_FEE=500
UNIV3_FACTORY=0xf0db7b58379503491d857dB50AC9ece64c653918

# Worker
MIN_FEE_GWEI=20
LOOP_MS=8000
DRY=1

# API
PORT=8788
DB_PATH=data/orders.db

# CORS origin allowed to call the order API (the launchpad "Smart Swap" widget). Default: *
CORS_ORIGIN=*
