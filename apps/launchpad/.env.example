# Arc Agent Launchpad UI — build-time env (Vite).
# Copy to apps/launchpad/.env for local dev; set the SAME variables in Vercel
# (Project → Settings → Environment Variables) for production builds.

# Keeper API base URLs (used by the "Smart Swap" widget). MUST be HTTPS in production
# (the DApp is served over HTTPS -> browsers block http/mixed content).
VITE_KEEPER_API=https://api.basepump.dev/arc-keeper
VITE_KEEPER_TESTNET_API=https://api.basepump.dev/arc-keeper-testnet

# Local dev defaults (if unset, the code falls back to these):
# VITE_KEEPER_API=http://127.0.0.1:8788
# VITE_KEEPER_TESTNET_API=http://127.0.0.1:8789
