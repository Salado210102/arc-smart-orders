# Arc launchpad alerts bot — copy to ops/launchpad-alerts.env (chmod 600) and fill.
# At least ONE target (Telegram or Discord) is required.

ARC_RPC=https://rpc.mainnet.arc.io
REGISTRY=0x8aE509565397C62a585c74aA44f7E3bFEab3Bb01
POLL_MS=30000
# START_BLOCK=            # optional: block to start scanning from (default: current)
# STATE_FILE=ops/.alerts-state.json

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- Discord (channel webhook) ---
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
