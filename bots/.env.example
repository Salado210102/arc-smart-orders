# Arc MEV — bots config (liquidation + oracle arbitrage). Copy to bots/.env (chmod 600).

ARC_RPC=https://rpc.mainnet.arc.io
USDC=0x3600000000000000000000000000000000000000
KEEPER_PK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Module 1: liquidation keeper ---
LENDING_POOL=
EXECUTOR=
COLLATERAL_ASSET=
SWAP_FEE=500
WATCHLIST=
# WATCHLIST_FILE=bots/watchlist.txt
DISCOVER_BORROWERS=1
LOOKBACK_BLOCKS=50000
HF_THRESHOLD=1.0
MIN_PROFIT_USDC=0.01
POLL_SECONDS=30

# --- Module 2: oracle arbitrage ---
ARB_EXECUTOR=
ORACLE=
ORACLE_EVENT_SIG=PriceFeedUpdate(bytes32,uint64,int64,uint64)
ORACLE_SCALE=1e8
POOL=
TOKEN_MID=
POOL_TOKEN0_DECIMALS=6
POOL_TOKEN1_DECIMALS=18
FEE_A=500
FEE_B=500
THRESHOLD_BPS=50
MIN_INPUT_USDC=1
MAX_INPUT_USDC=5000
HISTORY_FILE=bots/oracle_arb_history.json

# --- Module 3: JIT liquidity ---
JIT_EXECUTOR=
TOKEN1=
# POOL is shared with module 2 (Uniswap v3 pool)
TICK_SPACING=10
FEE=500
MIN_SWAP_USD=100000
PRICE_TOKEN1_IN_TOKEN0=2500
GAS_COST_USD=1
MIN_PROFIT_USD=10
CAPITAL0=50000
CAPITAL1=20
JIT_HISTORY_FILE=bots/jit_history.json

# --- Module 4: Morpho Blue liquidations (Arc mainnet Morpho: 0x34CD04070dD72b14E241112F6d83812Df5Af7fCD) ---
MORPHO=0x34CD04070dD72b14E241112F6d83812Df5Af7fCD
MORPHO_EXECUTOR=                    # ArcMorphoLiquidator (when deployed)
MORPHO_KEEPER=                      # the contract's keeper hot key (for eth_call sim without a PK)
COLLATERAL_TOKEN=                   # the market's collateral (e.g. cirBTC)
ORACLE=                             # the market's Morpho oracle
IRM=0xF02615d094Fc02fC031C35fe705e175aA4653f20   # Arc Adaptive Curve IRM
LLTV=0.86
REPAY_PCT=50
MAX_DEBT_USDC=5                     # pilot cap: only liquidate positions with debt <= this
MORPHO_HISTORY_FILE=bots/morpho_liq_history.json
