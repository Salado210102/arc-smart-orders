# Arc MEV — liquidation monitor config. Copy to bots/.env (chmod 600) and fill.

ARC_RPC=https://rpc.mainnet.arc.io

# Lending protocol to watch (Aave-v3/Morpho-style pool exposing getUserAccountData + liquidationCall)
LENDING_POOL=

# Your deployed ArcLiquidationKeeper
EXECUTOR=
# Collateral to seize (e.g. cirBTC)
COLLATERAL_ASSET=
USDC=0x3600000000000000000000000000000000000000
SWAP_FEE=500

# Keeper hot key (allowed by `onlyOwner`). Leave empty to run monitor-only.
KEEPER_PK=

# Discovery: comma-separated addresses and/or a file (one per line)
WATCHLIST=
# WATCHLIST_FILE=bots/watchlist.txt
DISCOVER_BORROWERS=1
LOOKBACK_BLOCKS=50000

# Risk / profit
HF_THRESHOLD=1.0
MIN_PROFIT_USDC=0.01
POLL_SECONDS=30

# Telegram (reuse the same bot as arc-alerts if you want)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
